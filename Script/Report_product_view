/*
===============================================================================================
Product Report
===============================================================================================

Purpose:
    - Consolidates key product metrics and performance indicators.

Highlights:
    1. Retrieves essential product attributes such as product name, category, subcategory, and cost.
    2. Segments products by revenue performance into High, Mid-range, and Low performers.
    3. Aggregates product-level metrics:
        - Total orders
        - Total sales
        - Total quantity sold
        - Total unique customers
        - Product lifespan (in months)
    4. Computes key performance indicators (KPIs):
        - Recency (months since last sale)
        - Average order revenue (AOR)
        - Average monthly revenue

===============================================================================================
*/

CREATE VIEW gold.report_products AS

-- 1. Product Info: Combines transactional and product attributes
WITH product_info AS (
    SELECT
        f.product_key,
        f.customer_key,
        p.product_name,
        p.subcatgory,
        p.category,
        p.cost,
        f.order_number,
        f.quantity,
        f.sales_amount,
        f.order_date
    FROM gold.fact_sales f
    LEFT JOIN gold.dim_product p
        ON f.product_key = p.product_key
    WHERE f.order_date IS NOT NULL
),

-- 2. Product Aggregation: Computes product-level performance metrics
product_segmentation AS (
    SELECT 
        product_key,
        product_name,
        category,
        subcatgory,
        cost,
        MAX(order_date) AS last_order,
        MIN(order_date) AS first_order,
        SUM(sales_amount) AS total_sales,
        COUNT(DISTINCT order_number) AS total_orders,
        SUM(quantity) AS total_quantity_sold,
        COUNT(DISTINCT customer_key) AS total_unique_customers,
        DATEDIFF(month, MIN(order_date), MAX(order_date)) AS lifespan,
        ROUND(
            AVG(CAST(sales_amount AS FLOAT) / NULLIF(quantity, 0)),
            1
        ) AS avg_selling_price
    FROM product_info
    GROUP BY
        product_key,
        product_name,
        category, 
        subcatgory,
        cost
)

-- 3. Final Select: Applies revenue segmentation and calculates KPIs
SELECT
    product_key,
    product_name,
    category,
    subcatgory,
    cost,
    last_order,
    lifespan,
    total_unique_customers,
    total_orders,
    total_sales,
    total_quantity_sold,
    avg_selling_price,

    -- Product revenue-based segmentation
    CASE 
        WHEN total_sales > 20000 AND total_unique_customers > 500 THEN 'High Performer'
        WHEN total_sales >= 10000 AND total_unique_customers >= 200 THEN 'Mid-range'
        ELSE 'Low Performer'
    END AS product_revenue_segmentation,

    -- Recency: months since last sale
    DATEDIFF(month, last_order, GETDATE()) AS recency,

    -- Average order revenue
    CASE 
        WHEN total_orders = 0 THEN 0
        ELSE total_sales / total_orders
    END AS avg_order_revenue,

    -- Average monthly revenue
    CASE 
        WHEN lifespan = 0 THEN 0
        ELSE total_sales / lifespan
    END AS avg_monthly_revenue

FROM product_segmentation;
