/* 
================================================================================================
Customer Report
================================================================================================

Purpose:
    - Consolidates key customer metrics and behavioral insights into a single view.

Highlights:
    1. Retrieves core customer attributes such as name, age, and transaction details.
    2. Segments customers by:
       - Spending behavior (VIP, Regular, New)
       - Age groups
    3. Aggregates customer-level metrics:
       - Total orders
       - Total sales
       - Total quantities purchased
       - Total distinct products purchased
       - Customer lifespan (in months)
    4. Computes key performance indicators (KPIs):
       - Recency (months since last order)
       - Average order value
       - Average monthly spend

================================================================================================
*/

CREATE VIEW gold.report_customers AS

-- 1. Base Query: Retrieves core transactional and customer attributes
WITH base_query AS (
    SELECT
        f.order_number,
        f.product_key,
        f.order_date,
        f.sales_amount,
        f.quantity,
        c.customer_key,
        c.customer_number,
        CONCAT(c.firstname, ' ', c.lastname) AS customer_name,
        DATEDIFF(year, c.birth_date, GETDATE()) AS age
    FROM gold.fact_sales f
    LEFT JOIN gold.dim_customer c
        ON f.customer_key = c.customer_key
    WHERE f.order_date IS NOT NULL
),

-- 2. Customer Aggregation: Summarizes metrics at the customer level
customer_aggregation AS (
    SELECT 
        customer_key,
        customer_number,
        customer_name,
        age,
        COUNT(DISTINCT order_number) AS total_orders,
        SUM(sales_amount) AS total_sales,
        SUM(quantity) AS total_quantity,
        COUNT(DISTINCT product_key) AS total_products,
        MAX(order_date) AS last_order,
        DATEDIFF(month, MIN(order_date), MAX(order_date)) AS lifespan
    FROM base_query
    GROUP BY 
        customer_key,
        customer_number,
        customer_name,
        age
)

-- 3. Final Select: Applies segmentation rules and calculates KPIs
SELECT 
    customer_key,
    customer_number,
    customer_name,

    -- Customer age grouping
    CASE
        WHEN age < 20 THEN 'Under 20'
        WHEN age BETWEEN 20 AND 29 THEN '20–29'
        WHEN age BETWEEN 30 AND 39 THEN '30–39'
        WHEN age BETWEEN 40 AND 49 THEN '40–49'
        ELSE '50 and Above'
    END AS age_group,

    -- Customer segmentation based on purchase behavior
    CASE 
        WHEN lifespan >= 12 AND total_sales > 5000 THEN 'VIP'
        WHEN lifespan >= 12 AND total_sales <= 5000 THEN 'Regular'
        ELSE 'New'
    END AS customer_category,

    -- Recency: months since last purchase
    DATEDIFF(month, last_order, GETDATE()) AS recency,

    total_orders,
    total_sales,
    total_quantity,
    total_products,
    lifespan,

    -- Average order value
    CASE 
        WHEN total_orders = 0 THEN 0
        ELSE total_sales / total_orders
    END AS avg_order_value,

    -- Average monthly spend
    CASE 
        WHEN lifespan = 0 THEN total_sales
        ELSE total_sales / lifespan
    END AS avg_monthly_spend

FROM customer_aggregation;


-- View validation
SELECT * 
FROM gold.report_customers;
