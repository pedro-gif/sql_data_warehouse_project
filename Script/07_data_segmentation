-- Data Segmentation
-- Segments products into cost ranges and analyzes sales performance per segment

WITH product_segment AS (
    SELECT
        product_key,
        product_name,
        cost,

        -- Assign cost range bucket for each product
        CASE 
            WHEN cost < 100 THEN 'Below 100'
            WHEN cost BETWEEN 100 AND 500 THEN '100–500'
            WHEN cost BETWEEN 500 AND 1000 THEN '500–1000'
            WHEN cost BETWEEN 1000 AND 1500 THEN '1000–1500'
            ELSE 'Above 1500'
        END AS cost_range
    FROM gold.dim_product
)

SELECT
    p.cost_range,
    COUNT(p.product_key) AS total_products,
    SUM(f.sales_amount) AS total_sales_amount
FROM product_segment p
LEFT JOIN gold.fact_sales f
    ON p.product_key = f.product_key
GROUP BY 
    p.cost_range;
