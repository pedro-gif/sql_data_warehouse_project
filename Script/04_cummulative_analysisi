-- Cumulative Analysis
-- Progressive aggregation of sales data over time
-- Calculates monthly total sales, moving average price, and running total of sales

SELECT 
    order_date,
    total_sales,
    AVG(avg_price) OVER (ORDER BY order_date) AS moving_average,
    SUM(total_sales) OVER (PARTITION BY order_date ORDER BY order_date) AS running_total
FROM
(
    SELECT
        DATETRUNC(month, order_date) AS order_date_month,
        DATETRUNC(year, order_date) AS order_date,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE DATETRUNC(year, order_date) IS NOT NULL
    GROUP BY 
        DATETRUNC(month, order_date),
        DATETRUNC(year, order_date)
) t;
